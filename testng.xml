<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Full regression: every Neighbourhood Register scenario. Run with: mvn test -->
<suite name="Neighbourhood Register - Full Regression" verbose="1">
  <test name="Register - Field Validation">
    <classes>
      <class name="TestRegister.RegisterFieldValidationTest"/>
    </classes>
  </test>
  <test name="Register - UI and Behaviour">
    <classes>
      <class name="TestRegister.RegisterFormBehaviourTest"/>
    </classes>
  </test>
  <test name="Register - Review and Submit">
    <classes>
      <class name="TestRegister.ReviewAndSubmitTest"/>
    </classes>
  </test>
  <test name="Check Status">
    <classes>
      <class name="TestStatus.CheckStatusTest"/>
    </classes>
  </test>
  <test name="Navigation and Layout">
    <classes>
      <class name="TestNavigation.NavigationTest"/>
    </classes>
  </test>
  <test name="End to End">
    <classes>
      <class name="EndToEndFlow.NeighbourhoodRegisterEndToEndTest"/>
    </classes>
  </test>
</suite>
